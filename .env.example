# 这些变量要填在 Netlify 的 Environment variables 里，不要提交真实的值。
ANTHROPIC_API_KEY=            # 你的 Anthropic API key（只放在服务器端）
ALLOWED_EMAILS=               # 允许使用 AI 的邮箱，用英文逗号隔开（必填，留空则 AI 一律拒绝）
MODEL_DEFAULT=                # 可选，默认 claude-sonnet-5-5（如果遇到 10 秒超时，可设为 claude-haiku-5-5）
MODEL_QUICK=                  # 可选，默认 claude-haiku-5-5
